# Supabase (local values are printed by `pnpm db:status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site URL used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (generate with `pnpm vapid`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Integration tests only (never exposed to the browser)
SUPABASE_SECRET_KEY=
